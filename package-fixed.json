    "word-wrap":            "1.2.4",
    "terser":               "5.14.2",
    "minimatch":            "3.0.5",
    "decode-uri-component": "0.2.1",
    "http-cache-semantics": "4.1.1",
    "tough-cookie":         "4.1.3",
    "follow-redirects":     "1.15.4",
    "xml2js":               "0.5.0",
    "json-schema":          "0.4.0"
  }
